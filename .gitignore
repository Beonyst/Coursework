*.tlh
*.tmp
*.tmp_proj
*_wpftmp.csproj
*.log
*.vspscc
*.vssscc
.builds
*.pidb
*.svclog
*.scc

# Тестовые файлы Chutzpah
_Chutzpah*

# Файлы кеша Visual C++
ipch/
*.aps
*.ncb
*.opendb
*.opensdf
*.sdf
*.cachefile
*.VC.db
*.VC.VC.opendb

# Профайлер Visual Studio
*.psess
*.vsp
*.vspx
*.sap

# Файлы трассировки Visual Studio
*.e2e

# Локальная рабочая область TFS 2012
$tf/

# Toolkit для автоматизации Guidance
*.gpState

# ReSharper - дополнение для .NET
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# TeamCity - дополнение для сборки
_TeamCity*

# DotCover - инструмент покрытия кода
*.dotCover

# AxoCover - инструмент покрытия кода
.axoCover/*
!.axoCover/settings.json

# Coverlet - бесплатный кроссплатформенный инструмент покрытия кода
coverage*.json
coverage*.xml
coverage*.info

# Результаты покрытия кода Visual Studio
*.coverage
*.coveragexml

# NCrunch
_NCrunch_*
.*crunch*.local.xml
nCrunchTemp_*

# MightyMoose
*.mm.*
AutoTest.Net/

# Веб-работа с sass
.sass-cache/

# Папка вывода Installshield
[Ee]xpress/

# DocProject - генератор документации
DocProject/buildhelp/
DocProject/Help/*.HxT
DocProject/Help/*.HxC
DocProject/Help/*.hhc
DocProject/Help/*.hhk
DocProject/Help/*.hhp
DocProject/Help/Html2
DocProject/Help/html

# Каталог Click-Once
publish/

# Вывод публикации Web
*.[Pp]ublish.xml
*.azurePubxml
# Примечание: Раскомментируйте следующую строку, если хотите зафиксировать настройки развертывания веб-сайта,
# но строки подключения к базе данных (с возможными паролями) будут незашифрованы
*.pubxml
*.publishproj

# Настройки публикации веб-сайта Microsoft Azure. Раскомментируйте следующую строку, если хотите
# зафиксировать настройки публикации веб-сайта Azure, но конфиденциальная информация в этих скриптах будет незашифрована
PublishScripts/

# Пакеты NuGet
*.nupkg
# Пакеты символов NuGet
*.snupkg
# Папка пакетов может быть проигнорирована из-за восстановления пакетов
**/[Pp]ackages/*
# за исключением build/, который используется как цель MSBuild.
!**/[Pp]ackages/build/
# Раскомментируйте, если необходимо, однако обычно она будет воссоздана при необходимости
#!**/[Pp]ackages/repositories.config
# Файлы project.json NuGet v3 генерируют больше игнорируемых файлов
*.nuget.props
*.nuget.targets

# Выходные данные Microsoft Azure Build
csx/
*.build.csdef

# Эмулятор Microsoft Azure
ecf/
rcf/

# Пакеты и файлы приложений для Windows Store
AppPackages/
BundleArtifacts/
Package.StoreAssociation.xml
_pkginfo.txt
*.appx
*.appxbundle
*.appxupload

# Файлы кеша Visual Studio
# файлы, заканчивающиеся на .cache, могут быть проигнорированы
*.[Cc]ache
# но отслеживайте каталоги, заканчивающиеся на .cache
!?*.[Cc]ache/

# Прочее
ClientBin/
~$*
*~
*.dbmdl
*.dbproj.schemaview
*.jfm
*.pfx
*.publishsettings
orleans.codegen.cs

# Включение файлов с сильным именем может представлять собой угрозу безопасности
# (https://github.com/github/gitignore/pull/2483#issue-259490424)
#*.snk

# Поскольку существует несколько рабочих процессов, расскоментируйте следующую строку, чтобы игнорировать bower_components
# (https://github.com/github/gitignore/pull/1529#issuecomment-104372622)
#bower_components/

# Проекты RIA/Silverlight
Generated_Code/

# Резервные файлы и отчеты от преобразования старого файла проекта
# в более новую версию Visual Studio. Резервные файлы не нужны,
# потому что у нас есть git ;-)
_UpgradeReport_Files/
Backup*/
UpgradeLog*.XML
UpgradeLog*.htm
ServiceFabricBackup/
*.rptproj.bak

# Файлы SQL Server
*.mdf
*.ldf
*.ndf

# Проекты Business Intelligence
*.rdl.data
*.bim.layout
*.bim_*.settings
*.rptproj.rsuser
*- [Bb]ackup.rdl
*- [Bb]ackup ([0-9]).rdl
*- [Bb]ackup ([0-9][0-9]).rdl

# Microsoft Fakes
FakesAssemblies/

# Файл настроек плагина GhostDoc
*.GhostDoc.xml

# Инструменты Node.js для Visual Studio
.ntvs_analysis.dat
node_modules/

# Сборочный лог Visual Studio 6
*.plg

# Файл опций рабочей области Visual Studio 6
*.opt

# Автоматически генерируемый файл рабочей области Visual Studio 6 (содержит информацию о том, какие файлы были открыты и т.д.)
*.vbw

# Выходные данные сборки Visual Studio LightSwitch
**/*.HTMLClient/GeneratedArtifacts
**/*.DesktopClient/GeneratedArtifacts
**/*.DesktopClient/ModelManifest.xml
**/*.Server/GeneratedArtifacts
**/*.Server/ModelManifest.xml
_Pvt_Extensions

# Paket - менеджер зависимостей
.paket/paket.exe
paket-files/

# FAKE - F# Make
.fake/

# Личные настройки CodeRush
.cr/personal

# Инструменты Python для Visual Studio (PTVS)
__pycache__/
*.pyc

# Cake - Раскомментируйте, если используете его
# tools/**
# !tools/packages.config

# Tabs Studio
*.tss

# Конфигурационный файл Telerik JustMock
*.jmconfig

# Выходные данные сборки BizTalk
*.btp.cs
*.btm.cs
*.odx.cs
*.xsd.cs

# Результаты анализа OpenCover UI
OpenCover/

# Выходные данные локального запуска Azure Stream Analytics
ASALocalRun/

# Двоичные и структурированные журналы MSBuild
*.binlog

# Конфигурационный файл отладчика GPU NVidia Nsight
*.nvuser

# Рабочая папка MFractors (инструмент для повышения производительности Xamarin)
.mfractor/

# Локальная история для Visual Studio
.localhistory/

# Временная база данных для проверки состояния в BeatPulse
healthchecksdb

# Резервная папка для инструмента Package Reference Convert в Visual Studio 2017
MigrationBackup/

# Рабочая папка Ionide (кроссплатформенные инструменты F# для VS Code)
.ionide/

# Fody - автоматически генерируемая XML схема
FodyWeavers.xsd
