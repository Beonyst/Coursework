###############################################################################
# Установить поведение по умолчанию для автоматической нормализации окончания строк.
###############################################################################
* text=auto

###############################################################################
# Установить поведение по умолчанию для diff в командной строке.
#
# Это необходимо для более ранних версий msysgit, которые не включают это
# по умолчанию для файлов csharp.
# Примечание: Это используется только в командной строке
###############################################################################
#*.cs     diff=csharp

###############################################################################
# Установить драйвер слияния для файлов проектов и решений.
#
# Слияние из командной строки добавит маркеры diff в файлы, если возникнут
# конфликты (слияние из VS не затрагивает настройки ниже, в VS
# маркеры diff никогда не вставляются). Маркеры diff могут привести к тому,
# что следующие расширения файлов не будут загружаться в VS. Альтернативой будет
# трактовать эти файлы как бинарные, и они всегда будут конфликтовать, требуя
# вмешательства пользователя при каждом слиянии. Для этого просто раскомментируйте
# нижеуказанные записи
###############################################################################
#*.sln       merge=binary
#*.csproj    merge=binary
#*.vbproj    merge=binary
#*.vcxproj   merge=binary
#*.vcproj    merge=binary
#*.dbproj    merge=binary
#*.fsproj    merge=binary
#*.lsproj    merge=binary
#*.wixproj   merge=binary
#*.modelproj merge=binary
#*.sqlproj   merge=binary
#*.wwaproj   merge=binary

###############################################################################
# Поведение для файлов изображений
#
# Изображения по умолчанию обрабатываются как бинарные файлы.
###############################################################################
#*.jpg   binary
#*.png   binary
#*.gif   binary

###############################################################################
# Поведение diff для общих форматов документов
# 
# Преобразовать бинарные форматы документов в текст перед сравнением. Эта
# функция доступна только из командной строки. Включите ее, раскомментировав
# записи ниже.
###############################################################################
#*.doc   diff=astextplain
#*.DOC   diff=astextplain
#*.docx  diff=astextplain
#*.DOCX  diff=astextplain
#*.dot   diff=astextplain
#*.DOT   diff=astextplain
#*.pdf   diff=astextplain
#*.PDF   diff=astextplain
#*.rtf   diff=astextplain
#*.RTF   diff=astextplain
