<Project Sdk="Microsoft.NET.Sdk">

  <!-- Основные параметры проекта -->
  <PropertyGroup>
    <!-- Указывает, что проект предназначен для создания Windows-приложения (WinExe). -->
    <OutputType>WinExe</OutputType>
    <!-- Задает целевую платформу .NET 8.0 для Windows. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- Включает поддержку Nullable Reference Types. -->
    <Nullable>enable</Nullable>
    <!-- Включает использование неявных `using` директив. -->
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Указывает, что проект использует WPF. -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!-- Управление файлами в проекте -->
  <ItemGroup>
    <!-- Удаляет файл `appsettings.json` из категории "None". -->
    <None Remove="appsettings.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Добавляет файл `appsettings.json` в проект с определенными параметрами. -->
    <Content Include="appsettings.json">
      <!-- Копирует файл в выходную директорию только при изменении. -->
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <!-- Исключает файл из единого исполняемого файла при публикации. -->
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <!-- Указывает, что файл должен быть скопирован в директорию публикации только при изменении. -->
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- Подключение зависимостей -->
  <ItemGroup>
    <!-- Autofac: библиотека для управления зависимостями и внедрения зависимостей. -->
    <PackageReference Include="Autofac" Version="8.1.0" />
    <!-- Extended.Wpf.Toolkit: набор дополнительных контролов для WPF. -->
    <PackageReference Include="Extended.Wpf.Toolkit" Version="4.6.1" />
    <!-- Microsoft.Extensions.Configuration и связанные пакеты: поддержка конфигурации приложения. -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.FileExtensions" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
    <!-- Newtonsoft.Json: библиотека для работы с JSON. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
