<!-- Определение основного пользовательского элемента управления для отображения панели с редакторами и их содержимым -->
<UserControl x:Class="Wpf.Views.uscMain"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <!-- Ресурсы, такие как стили для различных элементов управления -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Подключение стилей для ListBox, границ, общих элементов и кнопок -->
                <ResourceDictionary Source="../Styles/ListBox.xaml"/>
                <ResourceDictionary Source="../Styles/Border.xaml"/>
                <ResourceDictionary Source="../Styles/Common.xaml"/>
                <ResourceDictionary Source="../Styles/Button.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Основная сетка для размещения элементов -->
    <Grid>
        <!-- Определение колонок, одна фиксированная ширина и другая растягивается -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="254"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Граница с теневым стилем для левой панели -->
        <Border Grid.Column="0" Style="{StaticResource shadowBorder}"/>

        <!-- Сетка для левой панели с отображением списка редакторов -->
        <Grid Grid.Column="0" Background="{StaticResource LightGrayBrush}">
            <Grid.Style>
                <!-- Стиль для управления доступностью панели на основе состояния -->
                <Style TargetType="Grid">
                    <Setter Property="IsEnabled" Value="True"/>
                    <Style.Triggers>
                        <!-- Триггеры для отключения панели, если видимость других панелей активна -->
                        <DataTrigger Binding="{Binding SelectedEditorViewModel.IsDeletePanelVisible}" Value="True">
                            <Setter Property="IsEnabled" Value="False"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SelectedEditorViewModel.IsEditorPanelVisible}" Value="True">
                            <Setter Property="IsEnabled" Value="False"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <!-- Список редакторов, с привязкой к данным и стилизованный с использованием кнопок -->
            <ListBox Style="{StaticResource BorderlessListBox}" FontSize="18" ItemsSource="{Binding EditorViewModels}" 
                     SelectedItem="{Binding SelectedEditorViewModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <!-- Элементы списка отображаются как радиокнопки с привязкой к выбранному элементу -->
                    <DataTemplate>
                        <RadioButton FontSize="{Binding FontSize, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBox}}" 
                                     Style="{StaticResource FlatToggleButton}" Margin="0" Focusable="False" 
                                     HorizontalContentAlignment="Left" Padding="8" FontFamily="{StaticResource FontMain}"
                                     IsChecked="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBoxItem}}, Path=IsSelected}">
                            <RadioButton.Content>
                                <!-- Отображение имени редактора -->
                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                            </RadioButton.Content>
                        </RadioButton>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Отображение содержимого выбранного редактора в правой панели -->
        <ContentPresenter Grid.Column="1" Content="{Binding SelectedEditorViewModel}" Margin="4, 0, 0, 0"/>
    </Grid>
</UserControl>
