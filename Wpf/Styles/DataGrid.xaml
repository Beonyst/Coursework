<!-- 
    Этот файл XAML содержит стили для компонента DataGrid в приложении WPF.
    Он включает в себя два стиля: один для ячеек DataGrid, а второй — для всего DataGrid. 
    Также он подключает общий ресурсный словарь "Common.xaml" для использования общих стилей и ресурсов.
-->

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <!-- Подключение внешнего словаря ресурсов, содержащего общие стили и ресурсы -->
        <ResourceDictionary Source="Common.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Стиль для ячеек DataGrid -->
    <Style x:Key="CustomDataGridCell" TargetType="{x:Type DataGridCell}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridCell}">
                    <!-- Шаблон ячейки DataGrid: используется сетка с привязкой фона и контента -->
                    <Grid Background="{TemplateBinding Background}">
                        <ContentPresenter VerticalAlignment="Center" Margin="4" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль для DataGrid -->
    <Style x:Key="CustomDataGrid" TargetType="{x:Type DataGrid}">
        <!-- Установка цвета линий сетки -->
        <Setter Property="HorizontalGridLinesBrush" Value="LightGray" />
        <Setter Property="VerticalGridLinesBrush" Value="LightGray" />
        
        <!-- Отображение только заголовков столбцов -->
        <Setter Property="HeadersVisibility" Value="Column" />
        
        <!-- Установка фона для чередующихся строк -->
        <Setter Property="AlternatingRowBackground" Value="{StaticResource LightGrayBrush}" />
        
        <!-- Высота строк DataGrid -->
        <Setter Property="RowHeight" Value="30" />
        
        <!-- Установка шрифта и его размера для DataGrid -->
        <Setter Property="FontFamily" Value="{StaticResource Font}" />
        <Setter Property="FontSize" Value="14" />
        
        <!-- Установка цвета рамки DataGrid -->
        <Setter Property="BorderBrush" Value="{StaticResource BlackBrush}"/>
        
        <!-- Применение стиля ячеек для всего DataGrid -->
        <Setter Property="CellStyle" Value="{StaticResource CustomDataGridCell}"/>
        
        <!-- Отступы вокруг DataGrid -->
        <Setter Property="Margin" Value="4" />
    </Style>
</ResourceDictionary>
